<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Inserts the facet bar, the "Categories" button and the tree overlay.
         CHECK ON THE INSTANCE: the xpath `expr` has to point at a container that
         really exists in Odoo 19's point_of_sale.ProductScreen template - the exact
         class of the product column can differ. If it does not match, repoint it. -->
    <!-- Odoo 19 ProductScreen: there is no 'product-list-container'; the product area
         lives at rightpane > position-relative > CategorySelector + product-list
         (t-foreach). We anchor on CategorySelector, the first stable child of the
         position-relative container, which guarantees DarakjianCategoryTree ends up
         inside the position-relative ancestor its position:absolute/inset:0 overlay
         needs. -->
    <t t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//CategorySelector" position="before">
            <div class="darakjian-pos-nav">
                <button class="darakjian-tree-toggle btn btn-secondary"
                        t-on-click="() => this.openDarakjianTree()">
                    <i class="fa fa-sitemap me-1"/> Categories
                </button>
                <DarakjianBreadcrumb/>
                <DarakjianFacetBar/>
            </div>
        </xpath>
        <xpath expr="//CategorySelector" position="after">
            <DarakjianCategoryTree/>
            <DarakjianCaseSerialPicker/>
        </xpath>
        <!-- Remove the native CategorySelector: category navigation happens solely
             through the custom vertical tree. -->
        <xpath expr="//CategorySelector" position="replace"/>
        <!-- Stock badge: how many units are on hand, right on the card, so a cashier
             typing a quantity higher than what exists sees a number instead of only
             the native qty-turns-red feedback after the fact. -->
        <xpath expr="//ProductCard" position="attributes">
            <attribute name="darakjianStockQty">pos.darakjianStockQty(product)</attribute>
        </xpath>
    </t>

</templates>
