<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Lazy-loading for product images in the POS.
         CAUSA: el <img> nativo de point_of_sale.ProductCard no declara
         loading="lazy". When the grid paints (up to 100 products, the native cap)
         de productsToDisplay), el browser dispara ~100 requests de
         the browser fires 100 simultaneous /web/image/.../image_128 requests and
         decodes 100 images on the main thread, and the tab freezes.
         Fix: loading="lazy" makes the browser fetch only the images that fall in
         the viewport (~12), and decoding="async" moves decoding off the main
         thread. Minimally invasive: two standard HTML attributes on the <img>,
         with the card logic untouched. -->
    <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-img')]/img" position="attributes">
            <attribute name="loading">lazy</attribute>
            <attribute name="decoding">async</attribute>
        </xpath>
    </t>

</templates>
