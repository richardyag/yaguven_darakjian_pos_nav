<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="yaguven_darakjian_pos_nav.CaseSerialPicker">
        <div class="darakjian-tree-overlay" t-if="isOpen">
            <div class="darakjian-tree-backdrop" t-on-click="() => this.close()"/>
            <div class="darakjian-tree-panel darakjian-case-panel">
                <div class="darakjian-tree-header">
                    <span class="darakjian-tree-title">
                        Which case? <t t-esc="product.display_name"/>
                    </span>
                    <button class="darakjian-tree-close" t-on-click="() => this.close()">✕</button>
                </div>

                <div class="darakjian-tree-body darakjian-case-body">
                    <div class="darakjian-case-section-title">Pick the case it comes from</div>
                    <t t-if="!casesForProduct.length">
                        <div class="darakjian-case-empty">Nothing on hand right now.</div>
                    </t>
                    <div t-foreach="casesForProduct" t-as="c" t-key="c.id"
                         class="darakjian-tree-row darakjian-case-row"
                         t-on-click="() => this.selectCase(c.id)">
                        <span class="darakjian-case-item-name"><t t-esc="c.name"/></span>
                        <span class="darakjian-case-item-meta">qty <t t-esc="c.count"/></span>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
